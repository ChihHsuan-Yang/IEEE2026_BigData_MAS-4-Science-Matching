# Notebooks
.ipynb_checkpoints/

# Run artifacts: protocol traces, result tables, staged release trees.
# These are large and are distributed through the dataset release, not here.
# Anchored with a leading slash so they match only at the repository root --
# an unanchored `dataset_release/` would also swallow scripts/dataset_release/,
# which is released source code.
/data/
/results/
/outputs/
/dataset_release/
/logs/
*.jsonl
*.parquet
*.zst
*.log
