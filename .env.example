# ---------------------------------------------------------------------------
# SciAgentTrace protocol runner -- example environment
#
# Copy to `.env` and fill in for your own deployment, or export these directly.
# `.env` is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Inference endpoint (required) -----------------------------------------
# Any OpenAI-compatible chat-completions endpoint: the OpenAI API itself, a
# self-hosted vLLM server, or an institutional inference gateway.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://your-endpoint.example/v1

# --- Optional: gateway-specific behaviour ----------------------------------
# Some gateways need extra handling. Both are plain substrings matched against
# OPENAI_BASE_URL; leave unset for a standard OpenAI-compatible server.
#
# Identifies a gateway that issues short-lived tokens and reports expiry
# through auth-error messages the client can recognise:
# OPENAI_GATEWAY_HOST_MATCH=your-gateway.example
#
# Identifies a deployment that accepts only provider-free model names
# ("gpt-oss-120b" rather than "openai/gpt-oss-120b"):
# OPENAI_GATEWAY_ALIAS_MATCH=/your-deployment/
#
# Shell command that prints a fresh access token on stdout. Invoked when the
# gateway reports an expired token. Leave unset to re-authenticate manually.
# OPENAI_TOKEN_REFRESH_CMD=your-auth-helper print-token

# --- Optional: split-backend routing ---------------------------------------
# When one backend serves the actor model and another serves the evaluator,
# route actor traffic deterministically per worker. See agentverse/llms/openai.py.
# OPENAI_BASE_URL_GEMMA_DEV=https://second-backend.example/v1
# OPENAI_BASE_URL_GEMMA_FORCE=https://second-backend.example/v1

# --- Throttling / retry ----------------------------------------------------
# Soft cap on in-flight requests per process. Pick from a smoke ladder against
# your own endpoint; the right value is deployment-specific.
AGENTVERSE_RATE_SOFT_LIMIT=8
# AGENTVERSE_RATE_LIMIT_BACKOFF_CAP=60
# AGENTVERSE_TRANSIENT_MAX_ATTEMPTS=4
# AGENTVERSE_TRANSIENT_BACKOFF_CAP=8

# --- Paths (all relative to the repository root by default) ----------------
# Benchmark inputs prepared by scripts/prepare_*.py
SCIAGENTTRACE_DATA_DIR=./data
# Protocol run outputs (traces, per-example results, run summaries)
SCIAGENTTRACE_RESULTS_DIR=./results

# --- Optional: local Omni-Judge evaluator ----------------------------------
# Local directory or Hugging Face id for the open-source Omni-Judge model.
# Used only with --extra_post_eval omni-judge; runs locally via transformers.
# OMNI_JUDGE_MODEL_PATH=/path/to/Omni-Judge

# --- Optional: release tooling ---------------------------------------------
# Target dataset repo for scripts/dataset_release/ upload helpers.
# HF_DATASET_REPO=your-org/your-dataset
# Extra local account names the staging safety scan should flag.
# SCIAGENTTRACE_SCAN_USERNAMES=
